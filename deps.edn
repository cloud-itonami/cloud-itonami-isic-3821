{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM).
 ;; Pinned by git/sha so this repo is standalone-forkable (no
 ;; monorepo-relative :local/root assumption) -- ISIC-3821 needs no
 ;; robotics (blueprint.edn :itonami.blueprint/robotics false: this
 ;; is a back-office coordination actor, never a physical-actuation
 ;; one -- it never directly operates sorting/incineration equipment
 ;; and never makes an environmental-permit-authority decision).
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:git/sha "a332a770a0d2b5193f81b54483bb954fb29ef8d7"}}
 :aliases
 {;; monorepo-internal dev -- pin transitive langgraph/langchain to
  ;; local checkouts when working inside the com-junkawasaki superproject.
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "wasteops.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5).
  :render-html {:main-opts ["-m" "wasteops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
